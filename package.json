    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "svelte-kit sync && svelte-package && publint",
    "version": "npm version patch",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:lib": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.lib.json",
    "check:a11y": "bash scripts/check-a11y.sh",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test:e2e": "playwright test",
    "test:unit": "vitest run --project=unit",
    "test:storybook": "vitest --project=storybook",
    "test": "pnpm run test:e2e && pnpm run test:unit",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "rm -rf static/storybook && storybook build -o static/storybook"
  },
